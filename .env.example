# NOWNodes (TOKEN2049 Origins hackathon key, mainnet only). Every Solana and Cardano read goes through it.
NOWNODES_API_KEY=
# Defaults point at NOWNodes; override SOLANA_RPC_URL only for local work before the key arrives.
SOLANA_RPC_URL=https://sol.nownodes.io
CARDANO_API_URL=https://ada-blockfrost.nownodes.io/api/v0

# Model: any OpenAI-compatible chat completions endpoint with tool calls (DeepSeek by default, like Chord Ask).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Direct, READ-ONLY connections to the existing Chord databases (use a read-only role; queries also run in READ ONLY transactions).
# Main index: Monad, Robinhood Chain, Arc, Avalanche, Base, BNB Chain. Solana index: the Solana box Postgres.
INDEX_DATABASE_URL=
SOLANA_DATABASE_URL=
# Symbols for EVM tokens come from Chord's public token lists; "off" disables the lookup.
CHORD_API=https://api.getchord.xyz

# Pay per ask: treasury addresses (receive only; this app never signs), prices, free asks per session.
TREASURY_SOL=
TREASURY_ADA=
PAY_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PRICE_USDC=0.1
PRICE_ADA=0.5
FREE_ASKS=3

# Sign-in + embedded wallets through a Privy app (its public app id). The app's domain list must include this site.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=

APP_NAME=Tapeline
PORT=8799
DB_PATH=data/ask2049.db
