# ── Monad and the trust layer ────────────────────────────────────────────────────────────────────────────────────────
MONAD_RPC_URL=https://rpc.monad.xyz
# The operator registers each trading agent on the ERC-8004 Identity Registry and commits its fills to TrackRecord.
# The validator answers validation requests with its own key. Both are hot keys holding a little MON only.
OPERATOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=
# From contracts/script/Deploy.s.sol. Empty TRACK_RECORD_ADDRESS = the trust layer is off (agents still run on paper).
TRACK_RECORD_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
# The public origin: agentURIs, request and report URIs point here.
PUBLIC_BASE_URL=http://localhost:8798
# 0 switches the trust layer off; below TRUST_MIN_OPERATOR_MON the operator sends nothing and waits for a top-up.
TRUST_ENABLED=1
TRUST_MIN_OPERATOR_MON=0.05

# ── Market data: Chord's API (Monad token list, prices, stats, candles, smart-money feed and board, router quotes) ──────
CHORD_API=https://api.getchord.xyz
# X-API-Key on every call; unset = anonymous, held to the per-IP limit
CHORD_API_KEY=

# ── Ask (any OpenAI-compatible chat completions endpoint with tool calls) ────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
ASK_MODEL_HEAVY=
ASK_MODEL_FALLBACK=
# LLM_MODEL=qwen3.6-plus (any id starting with qwen) goes to Alibaba Cloud Model Studio, international endpoint, with this key;
# ASK_MODEL_FALLBACK=deepseek-flash then answers when Qwen is down or out of quota. QWEN_THINKING=1 turns its thinking on.
QWEN_API_KEY=
QWEN_THINKING=
# Nansen (Ask tool nansen_smart_money: labelled smart money on Monad). Every call costs credits, so answers are kept in SQLite:
# holdings 24 h, trades 12 h (NANSEN_HOLDINGS_TTL_HOURS / NANSEN_TRADES_TTL_HOURS). Unset = the tool is not offered.
NANSEN_API_KEY=
FREE_ASKS=10
UNLIMITED_ASKS=

# ── The server ────────────────────────────────────────────────────────────────────────────────────────────────────────
APP_NAME=Chord Agents
PORT=8798
DB_PATH=data/chord-agents.db

# Optional Ask data families (each appears only when its key is set)
ASK_MODEL_X=
MINIMAX_API_KEY=
XAI_API_KEY=
TWITTERAPI_IO_KEY=
COINGLASS_API_KEY=
COINGLASS_ASK=
CMC_API_KEY=
TAVILY_API_KEY=
SOLANA_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=
AVAX_RPC_URL=
# Sign-in for the Trade tab (a Privy app's public id; its domain list must include this site)
PRIVY_APP_ID=
